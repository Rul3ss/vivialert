# ---------------------------------------------------------------------------
# Banco de dados (usado pelo docker-compose)
# ---------------------------------------------------------------------------
DB_USER=tripalert
DB_PASSWORD=troque-esta-senha
DB_NAME=tripalert

# Conexão usada pela API. O docker-compose monta esta URL sozinho a partir das
# variáveis acima; defina a linha abaixo apenas para rodar "pnpm start:dev"
# fora do Docker.
# DATABASE_URL=postgresql://tripalert:troque-esta-senha@localhost:5432/tripalert

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3000

# Chave de acesso da API (OBRIGATÓRIA, mínimo 16 caracteres).
# Sem ela o app não sobe — nunca mais a API aberta para qualquer um.
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# O frontend usa a mesma chave em VITE_API_KEY.
API_KEY=

# Origens liberadas no CORS, separadas por vírgula. Em desenvolvimento o Vite
# faz proxy de /alerts, então o padrão já atende o frontend em localhost:5173.
# Em produção, aponte para a URL onde o frontend está publicado.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Preços (Fase 1)
#   PRICE_PROVIDER=serpapi  → preço REAL (Google Flights via SerpApi)
#   PRICE_PROVIDER=fake     → preço SIMULADO (padrão; para desenvolvimento)
# Com "serpapi" é obrigatório ter SERPAPI_KEY. A tela e o /health avisam
# quando o preço é simulado.
# SERPAPI_KEY aceita várias chaves separadas por vírgula (sem espaço):
#   SERPAPI_KEY=chave1,chave2,chave3
# Cada checagem usa a próxima chave (round robin); se uma estiver sem cota,
# a próxima é tentada. 3 chaves free = 750 buscas/mês.
# ---------------------------------------------------------------------------
PRICE_PROVIDER=fake
SERPAPI_KEY=

# Frequência do vigia automático, em minutos (mínimo 15).
# Cota: cada ciclo gasta 1 busca por dia da janela de ida.
# Ex.: janela de 3 dias + 2 ciclos/dia = 6 buscas/dia ≈ 180/mês.
# O plano free da SerpApi dá 250 buscas/mês.
CHECK_INTERVAL_MINUTES=720

# "false" desliga o vigia automático (o botão "Checar preço" continua).
WATCH_ENABLED=true

# ---------------------------------------------------------------------------
# Telegram
# 1. Crie o bot com o @BotFather e cole o token abaixo.
# 2. Envie "oi" para o seu bot: ele não consegue iniciar conversa sozinho.
# 3. Pegue o id de QUEM RECEBE em https://api.telegram.org/bot<token>/getUpdates
#    (procure por "chat": { "id": ... })
# Depois de configurar, teste com: POST /notifications/test
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
